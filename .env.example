# Reference settings; use the app-specific .env.example files for launch instructions.
# Browser API origin (Vite appends /api/v1). Never put secrets in VITE_ variables.
VITE_AEGIS_RELAY_API_BASE=http://127.0.0.1:8000
# Core service frontend allowlist; uvicorn must be started with --env-file to read a file.
AEGIS_RELAY_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
